        /// <summary>
        /// 取得60電文中的活動
        /// </summary>
        /// <returns></returns>
        private void GetCampaign(UbotNewTradeModel respData, out string ErrorMsg, out int CampaignAmt, out EDC_ACT PointAmountCampaign, out List<EDC_ACT> PromotePrintCampaign)
        {
            ErrorMsg = "";
            var objCacheEDC_ACT = new CacheUtility().GetEDC_ACT();
            List<UbotNewActModel> listCampaign = new List<UbotNewActModel>()
            {
              new UbotNewActModel{ Campaign_SN = respData.Campaign_SN_1,Campaign_Result = respData.Campaign_Result_1},
              new UbotNewActModel{ Campaign_SN = respData.Campaign_SN_2,Campaign_Result = respData.Campaign_Result_2},
              new UbotNewActModel{ Campaign_SN = respData.Campaign_SN_3,Campaign_Result = respData.Campaign_Result_3}
            };
            CampaignAmt = int.Parse(respData.DiscountAmount);
            List<EDC_ACT> listMatchCampaign_SN = new List<EDC_ACT>();
            foreach (var itemCampaign in listCampaign)
            {
                if (!string.IsNullOrEmpty(itemCampaign.Campaign_SN) && !string.IsNullOrWhiteSpace(itemCampaign.Campaign_SN))
                {
                    var EDC_ACTdata = objCacheEDC_ACT.Where(x => x.Act_No == itemCampaign.Campaign_SN && x.Edc_Type == "30D1").FirstOrDefault();
                    if (EDC_ACTdata != null)
                    {
                        if (itemCampaign.Campaign_Result == "00")
                            listMatchCampaign_SN.Add(EDC_ACTdata);
                        else
                        {
                            var errMsg = CreditCardEnumExtensions.ToActErrMsg(itemCampaign.Campaign_Result);
                            if(!string.IsNullOrEmpty(errMsg))
                                ErrorMsg = "活動名稱: " + EDC_ACTdata.Act_Name + "<br/>❌未符合原因:" + CreditCardEnumExtensions.ToActErrMsg(itemCampaign.Campaign_Result);
                        }

                    }
                }
            }
            PointAmountCampaign = listMatchCampaign_SN.Where(x => x.Act_Type == "A").FirstOrDefault();
            //EDC_ACT無對應活動時，不可折抵，將CampaignAmt改為0
            if (PointAmountCampaign == null)
            {
                CampaignAmt = 0;
            }
            PromotePrintCampaign = listMatchCampaign_SN.Where(x => x.Act_Type == "B").ToList();
        }
