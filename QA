using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace POS.Devices
{
    public class DeviceSharedFunctions
    {
        /// <summary>
        /// 建立版本資訊  建版號txt
        /// </summary>
        /// <param name="strVersion">版本代碼</param>
        /// <returns></returns>
        public void CreateDeviceVersionFile(string deviceVerisonFileName, string version)
        {

            string strfolderPath = @"c:\POS\Web\Register\DeviceVersion\";
            // 判斷資料夾是否存在
            if (!Directory.Exists(strfolderPath))
            {
                // 自動建立資料夾
                Directory.CreateDirectory(strfolderPath);
            }

            string[] files = Directory.GetFiles(strfolderPath, deviceVerisonFileName + "*", SearchOption.TopDirectoryOnly);
            string strVersionFileName = deviceVerisonFileName + @"_" + version + ".txt";
            string newVesionFileName = strfolderPath + strVersionFileName;
            if (files.Length == 0)
            {
                // 建立空白檔案
                using (FileStream fs = File.Create(newVesionFileName))
                {
                    // 不寫入任何內容，保持空白
                }
            }
            else
            {
                if (files[0] != newVesionFileName)
                {
                    File.Move(files[0], newVesionFileName);
                    // 更新修改日期為現在
                    File.SetLastWriteTime(newVesionFileName, DateTime.Now);
                }
            }
        }
        /// <summary>
        /// 確認是否有新版本程式需要更新
        /// </summary>
        /// <param name="strVersion">版本代碼</param>
        /// <returns></returns>
        public string GetDeviceVersion(string deviceVerisonFileName)
        {
            string version = "";
            string strfolderPath = @"c:\POS\Web\Register\DeviceVersion\";
            // 判斷資料夾是否存在
            if (Directory.Exists(strfolderPath))
            {
                string[] files = Directory.GetFiles(strfolderPath, deviceVerisonFileName + "*", SearchOption.TopDirectoryOnly);
                if (files.Length > 0)
                {
                    string fileNameWithoutExt = Path.GetFileNameWithoutExtension(files[0]);
                    version = fileNameWithoutExt.Split('_')[1];

                }
            }
            return version;
        }
    }
}

