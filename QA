        private UbotNewTradeModel readCardCheckBin(Devices.Models.CreditCardModels.CreditCardSaleData data, string TransType, string HostID, string BinCheckflag, bool hasUbact, string campaignSN,out string msg)
        {
            msg = "";
            var act = false;
            POSLocalEntities db = new POSLocalEntities();
            UbotNewTradeModel reqData = new UbotNewTradeModel()
            {
                TransType = TransType,
                HostID = HostID,
                TransAmt = ((int)(data.amt)).ToString(),// 金額,兩位小數
                StartTransType = "01",
                ExceptionAmt = "0",
                SubAmt = "0",
                MerchantCode = data.StoreID,
                StoreID = data.StoreID
            };
            //有使用分期付款一開始詢卡StartTransType就要帶入04及分期期數(預設為3期)
            if (data.payType == CreditCardEnum.PayType.INSTALLMENT_SALE)
            {
                reqData.StartTransType = "04";
                reqData.InstallmentPeriod = 3.ToString("D2");
            }
            //有支付代收時詢卡就要帶入代收金額
            if (data.HasSaleCollection)
            {
                //總代收金額(包含代收手續費)
                string strTotalArcAmt = (Convert.ToInt32(data.arcAmt) + Convert.ToInt32(data.FeedAmt)).ToString();
                reqData.SubAmt = strTotalArcAmt;


            }
            //有排他金額時詢卡就要帶入排他金額
            if (data.Smoke > 0)
            {
                reqData.ExceptionAmt = ((int)data.Smoke).ToString();
            }
            //聯邦60活動開關 1.有代收 2. 無中台活動 符合其中一個條件則RequestCampaignID要帶XXX
            if (data.HasSaleCollection || !hasUbact || data.HasOnlineShoppingOrCloudFridge)
                reqData.RequestCampaignID = "XXX";
            else
                reqData.RequestCampaignID = "   ";
            #region 點加金
            var objPointAmount = new PaymentService().CalculatePointAmount(new Models.PaymentModel.CalculatePointAmountQuery()
            {
                PaymentId = GetRealPaymentID(data.payType, HostID),
                CardBin = "",
                PayAmount = data.amt,
                Custom_Code = "",
                CampaignDiscAmount = 0
            }, campaignSN);
            #endregion;
            Utility utility = new Utility();
            if (objPointAmount.body.DiscAmount != 0)
                reqData.Campaign_SN_1 = campaignSN;

            UbotNewTradeModel respData = Send(reqData);

            //詢卡失敗要發送TransType="70"取消交易電文
            if (respData.RespCode != "0000" && respData.RespCode != "0020")
            {
                reqData.TransType = "70";
                respData.HostID = null;
                respData.TransAmt = null;
                respData.StartTransType = null;
                respData.ExceptionAmt = null;
                respData.SubAmt = null;
                respData.MerchantCode = null;
                respData = Send(reqData);
                return respData;
            }

            //回傳的 Card NO.(Bin Code)需與 Bintable 比對是否符合
            if (!binCheck(respData.CardNo, BinCheckflag, out msg))
            {
                respData.RespCode = ((int)CreditCardEnum.UbotNewRespCode.Others).ToString();
            }
            var resp = CreditCardEnum.ParserUbotNew.RespCode(respData.RespCode);

            return respData;
        }

        private bool binCheck(string cardNo, string BinCheckflag,out string msg)
        {
            msg = "";
            POSLocalEntities db = new POSLocalEntities();
            //銷售作業
            if (BinCheckflag == "1")
            {
                bool canUse = new PublicController().CheckPayLimitIsAllow("05", "30D1", out msg,cardNo);

                return canUse;
            }
            //代收or分期
            else if (BinCheckflag == "2" || BinCheckflag == "3") //代收 + 分期檢核
            {
                //由收銀機依據所接收到的 BIN 比對 BINTABLE 判斷該信用卡是否可使用代收與分期業務
                if (db.ArcBincode.Where(x => x.Bincode == cardNo.Substring(0, x.Bincode.Length) && x.Bank == "UB").Any())
                {
                    return true;
                }
            }

            return false;
        }

