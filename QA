        public Devices.Models.CreditCardModels.CreditCardResponse refund(Devices.Models.CreditCardModels.CreditCardRefundRequest data, CreditCardEnum.CardType RefundCardType)
        {
            string TransType = CreditCardEnum.UbotNewTransType.REFUND.ToCode();
            string HostID = CreditCardEnum.UbotNewHostID.CREDITCARD.ToCode();
            string Eventcode = "";
            string SaleDate = "";
            string TransNo = "";

            if (string.IsNullOrEmpty(data.strTransToRefund))
            {
                SaleDate = "";
                TransNo = "";
            }
            else if (data.strTransToRefund.Length > 8)
            {
                SaleDate = data.strTransToRefund.Substring(0, 8);
                TransNo = data.strTransToRefund.Substring(9, 6);
            }
            else
            {
                SaleDate = data.strTransToRefund;
                TransNo = data.strTransNoToRefund;
            }

            POSLocalEntities db = new POSLocalEntities();
            var _Trans_P = db.Trans_P.Where(x => x.Trans_No == TransNo && x.Sales_Date == SaleDate).FirstOrDefault();
            var _Trans_P_EXT = db.Trans_P_Ext.Where(x => x.Trans_No == TransNo && x.Sales_Date == SaleDate || x.Edc_Ref_No == data.RefNo).FirstOrDefault();
            Eventcode = _Trans_P?.Event;

            string strRefNo = "";
            string strApprovalCode = "000000";

            if(data.IsCloudFridge) //整買刷退資料從電文來
            {
                strRefNo = data.RefNo;
                strApprovalCode = strApprovalCode;
            }
            else
            {
                strRefNo = _Trans_P_EXT?.Edc_Ref_No;
                strApprovalCode = _Trans_P_EXT?.Edc_Approval_Code;
            }
            var reqData = new UbotNewTradeModel()
            {
                TransType = TransType,
                HostID = HostID,
                TransAmt = ((int)(data.amt)).ToString(),               // 金額,兩位小數
                StoreID = data.StoreID,
                TransDate = data.POSDateTime.ToString("yyMMdd"),
                TransTime = data.POSDateTime.ToString("HHmmss"),
                MerchantCode = data.StoreID,
                ApprovalCode = strApprovalCode,
                RefNo = strRefNo
            };
            if (RefundCardType == CreditCardEnum.CardType.CUP)//銀聯卡
            {
                reqData.HostID = CreditCardEnum.UbotNewHostID.CUP.ToCode();

                reqData.TerminalID = _Trans_P?.Terminal ?? "";
                reqData.RefNo = strRefNo;
                reqData.CUPSettlementDate = _Trans_P_EXT?.Edc_Cup_Settlement_Date;
                reqData.CUPTxnDate = _Trans_P_EXT?.Edc_Cup_Txn_Date;
                reqData.CUPTxnTime = _Trans_P_EXT?.Edc_Cup_Txn_Time;
                reqData.CUPTxnSeq_No = _Trans_P_EXT?.Edc_Cup_Txn_Seq_No;
                reqData.ApprovalCode = strApprovalCode;
            }

            if (RefundCardType == CreditCardEnum.CardType.AE)//AE
            {
                reqData.HostID = CreditCardEnum.UbotNewHostID.AE.ToCode();
            }

            if (Eventcode == "30D5") // 分期
            {
                reqData.TransType = CreditCardEnum.UbotNewTransType.INSTALLMENT_REFUND.ToCode();
                reqData.HostID = CreditCardEnum.UbotNewHostID.PERIOD.ToCode();
                reqData.TerminalID = _Trans_P?.Terminal ?? "";
                reqData.RefNo = strRefNo;
                reqData.ApprovalCode = strApprovalCode;
                reqData.TransDate = _Trans_P_EXT.Sales_Date.Substring(2, _Trans_P_EXT.Sales_Date.Length - 2);
                reqData.InstallmentPeriod = 3.ToString("D2");
            }

            var respData = Send(reqData);

            var resp = CreditCardEnum.ParserUbotNew.RespCode(respData.RespCode);
            //if (resp != CreditCardEnum.UbotNewRespCode.Approval &&
            //    resp != CreditCardEnum.UbotNewRespCode.AppvBatchFull &&
            //    resp != CreditCardEnum.UbotNewRespCode.AppvNeedSign &&
            //    resp != CreditCardEnum.UbotNewRespCode.Error &&
            //    resp != CreditCardEnum.UbotNewRespCode.TimeOut)
            //{
            //    //先暫時註解 
            //    //return processTimeOut(reqData);
            //    //20220729已向HLF雅雲確認當簽名80發送後不管任何錯誤一律接著打55電文
            //    return Send55Request(reqData);
            //}
            var result = responseFromModel(respData);
            //如果TimeOut或者為C005,R003,R008錯誤代碼時要發送55重印簽單查詢交易是否成功
            if (respData.RespCode == "C005" || respData.RespCode == "R008" || respData.RespCode == "R003" || respData.RespCode == "0003")
            {
                //先暫時註解 
                //return processTimeOut(reqData);
                //20220729已向HLF雅雲確認當簽名80發送後不管任何錯誤一律接著打55電文
                result = Send55Request(reqData);
            }

            HostID = result.HostID;

           

            string strCardNoTit = result.CardNo.Substring(0, 1);
            if (result.CardType.ToString() == "UNKNOWN")
            {
                switch (strCardNoTit)
                {
                    case "3":
                        result.CardType = CreditCardEnum.CardType.JCB;
                        break;
                    case "4":
                        result.CardType = CreditCardEnum.CardType.VISA;
                        break;
                    case "5":
                        result.CardType = CreditCardEnum.CardType.MASTER;
                        break;
                    case "6":
                        result.CardType = CreditCardEnum.CardType.CUP;
                        break;
                }
            }
            result.HostID = HostID;
            //以銀行別判斷卡種
            switch (HostID)
            {
                //花旗銀行
                case "00":
                    result.CardType = CreditCardEnum.CardType.DinerSclub;
                    break;
                //美國運通
                case "01":
                    result.CardType = CreditCardEnum.CardType.AE;
                    break;
                //CUP銀聯
                case "02":
                    result.CardType = CreditCardEnum.CardType.CUP;
                    break;
            }
            result.EventCode = Eventcode;
            return result;
        }

        public Devices.Models.CreditCardModels.CreditCardResponse reprint(Devices.Models.CreditCardModels.CreditCardReprintRequest data, CreditCardEnum.CardType RefundCardType)
        {
            string TransType = CreditCardEnum.UbotNewTransType.REPRINT.ToCode();
            string HostID = CreditCardEnum.UbotNewHostID.CREDITCARD.ToCode();
            if (RefundCardType == CreditCardEnum.CardType.CUP)//銀聯卡
            {
                HostID = CreditCardEnum.UbotNewHostID.CUP.ToCode();
            }
            if (RefundCardType == CreditCardEnum.CardType.AE)//AE
            {
                HostID = CreditCardEnum.UbotNewHostID.AE.ToCode();
            }
            string dir = @"C:\POS\Web\Register\edc\UBNew";
            string outFilenameForReceiptNo = dir + @"\OutData.dat";
            if (!File.Exists(outFilenameForReceiptNo))
            {
                return new Devices.Models.CreditCardModels.CreditCardResponse()
                {

                };
            }
            var respDataForReceiptNo = new UbotNewTradeModel(File.ReadAllText(outFilenameForReceiptNo));
            var reqData = new UbotNewTradeModel()
            {
                TransType = TransType,
                HostID = HostID,
                InvoiceNo = respDataForReceiptNo.InvoiceNo,
                StoreID = data.StoreID,
                TransDate = data.POSDateTime.ToString("yyMMdd"),
                TransTime = data.POSDateTime.ToString("HHmmss"),
                MerchantCode = data.StoreID
            };
            var respData = Send(reqData);

            Devices.Models.CreditCardModels.CreditCardResponse response = responseFromModel(respData, reqData.TransAmt);

            string strCardNoTit = response.CardNo.Substring(0, 1);
            if (response.CardType.ToString() == "UNKNOWN")
            {
                switch (strCardNoTit)
                {
                    case "3":
                        response.CardType = CreditCardEnum.CardType.JCB;
                        break;
                    case "4":
                        response.CardType = CreditCardEnum.CardType.VISA;
                        break;
                    case "5":
                        response.CardType = CreditCardEnum.CardType.MASTER;
                        break;
                    case "6":
                        response.CardType = CreditCardEnum.CardType.CUP;
                        break;
                }
                //以銀行別判斷卡種
                switch (HostID)
                {
                    //花旗銀行
                    case "00":
                        response.CardType = CreditCardEnum.CardType.DinerSclub;
                        break;
                    //美國運通
                    case "01":
                        response.CardType = CreditCardEnum.CardType.AE;
                        break;
                    //CUP銀聯
                    case "02":
                        response.CardType = CreditCardEnum.CardType.CUP;
                        break;
                }
            }

            return response;
        }

        public Devices.Models.CreditCardModels.CreditCardResponse sale(Devices.Models.CreditCardModels.CreditCardSaleData data)
        {
            //DB Bincode_List比對用卡號
            string strCardNoForBinList = "";
            UbotNewTradeModel respData;
            CreditCardEnum.UbotNewRespCode respCode;
            //TransType:
            //SALE    01  一般交易(含CUP)
            //REFUND  02  退貨交易(含CUP)
            //OFFLINE 03  交易補登
