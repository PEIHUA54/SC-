        //如果上一筆是EDC交易，就衝印，否則返回錯誤信息
        public CreditCardEnum.ReprintStatus Reprint(out CreditCardResponse response)
        {
            response = new CreditCardResponse();

            var prevEDC = localPrevTransIsEDC();
            if (prevEDC is null) return CreditCardEnum.ReprintStatus.NOTEDC;
            CreditCardReprintRequest data = new CreditCardReprintRequest() { StoreID = prevEDC.StoreID, POSDateTime = this.POSDateTime };

            var cardreader = FactoryNewCreditCardReader();
            response = cardreader.reprint(data, RefundCardType);
            response.Amount = prevEDC.Amount;

            if (edcType == EDCType.CTBC)
            {
                if (response.CardType != prevEDC.CardType
                || response.TerminalID != prevEDC.TerminalID
                || response.CardNo != prevEDC.CardNo
                || response.TransDateTime != prevEDC.TransDateTime
                || response.InvoiceNo.Substring(0, 6) != prevEDC.ApprovalCode
                || response.StoreID != prevEDC.StoreID
                || response.POSDateTime != prevEDC.POSDateTime)
                {
                    return CreditCardEnum.ReprintStatus.NOTMATCH;
                }

            }
            else
            {
                if (response.TerminalID != prevEDC.TerminalID
                || response.CardNo != prevEDC.CardNo
                || response.TransDateTime != prevEDC.TransDateTime
                || response.InvoiceNo.Substring(0, 6) != prevEDC.ApprovalCode)
                {
                    return CreditCardEnum.ReprintStatus.NOTMATCH;
                }
            }

            return CreditCardEnum.ReprintStatus.SUCC;
        }

        public CreditCardEnum.ActionStatus Settlement(string HostID)
        {
            CreditCardResponse response;

            var cardreader = FactoryNewCreditCardReader();
            CreditCardSettleRequest data = new CreditCardSettleRequest()
            {
                HostID = HostID,
                StoreID = this.storeID,
                POSDateTime = this.POSDateTime
            };
            response = cardreader.settlement(data);

            if (response.status == CreditCardResponse.CreditCardStatus.Succ) return CreditCardEnum.ActionStatus.SUCC;
            if (response.status != CreditCardResponse.CreditCardStatus.Succ) return CreditCardEnum.ActionStatus.FAIL;
            return CreditCardEnum.ActionStatus.UNKNOWN;
        }
