        private Devices.Models.CreditCardModels.CreditCardResponse processTimeOut(UbotNewTradeModel reqData)
        {
            Devices.Models.CreditCardModels.CreditCardResponse response = new Devices.Models.CreditCardModels.CreditCardResponse();
            response.status = Devices.Models.CreditCardModels.CreditCardResponse.CreditCardStatus.Fail;

            for (int i = 0; i < 2; i++)
            {
                //暫停目前執行緒
                Thread.Sleep(5000);
                response = Send55Request(reqData);
                if (response.status == Devices.Models.CreditCardModels.CreditCardResponse.CreditCardStatus.Succ)
                {
                    response.status = Devices.Models.CreditCardModels.CreditCardResponse.CreditCardStatus.Succ;
                    break;
                }
            }

            return response;
        }

