        public CreditCardResponse SignSale(string StoreID, DateTime POSDateTime, CreditCardEnum.PayType payType, decimal? amount = null, string HostID = "", CreditCardResponse ResponseSale = null)
        {
            CreditCardSignRequest data = new CreditCardSignRequest
            {
                StoreID = StoreID,
                POSDateTime = POSDateTime,
                payType = payType,
                HostID = HostID,
                Amount = amount
            };

            var cardreader = FactoryNewCreditCardReader();
            var response = cardreader.signSale(data);
            var resp = CreditCardEnum.ParserUbotNew.RespCode(response.RespCode);
            //2024/05/09 80錯誤不需發55，商店聯用01印
            if (resp != CreditCardEnum.UbotNewRespCode.Approval)
            {
                response = ResponseSale;
                response.ESignUploadSucc = false;//80失敗表示上傳電簽失敗
            }

            response.Amount = amount;                   // EDC不回傳amount

            response.StoreID = storeIDForUBprint;
            string strCardNoTit = response.CardNo.Substring(0, 1);

            switch (strCardNoTit)
            {
                case "3":
                    response.CardType = CreditCardEnum.CardType.JCB;
                    break;
                case "4":
                    response.CardType = CreditCardEnum.CardType.VISA;
                    break;
                case "5":
                    response.CardType = CreditCardEnum.CardType.MASTER;
                    break;
                case "6":
                    response.CardType = CreditCardEnum.CardType.CUP;
                    break;
                default:
                    break;
            }
            if (edcType == EDCType.NEWUBOT)
            {
                response.HostID = HostID;
                //以銀行別判斷卡種
                switch (HostID)
                {
                    //花旗銀行
                    case "00":
                        response.CardType = CreditCardEnum.CardType.DinerSclub;
                        break;
                    //美國運通
                    case "01":
                        response.EventCode = "30D8";
                        response.CardType = CreditCardEnum.CardType.AE;
                        break;
                    //CUP銀聯
                    case "02":
                        response.EventCode = "30D2";
                        response.CardType = CreditCardEnum.CardType.CUP;
                        break;
                }
            }

            return response;
        }

