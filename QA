                }
                #endregion

                reqData = new UbotNewTradeModel()
                {
                    TransType = CreditCardEnum.UbotNewTransType.SALE.ToCode(),
                    HostID = HostID,
                    TransAmt = ((int)(data.amt)).ToString(),
                    ExceptionAmt = intExceptionAmt.ToString(),
                    MerchantCode = data.StoreID,
                    CardNo = respData.CardNo,
                    StoreID = data.StoreID
                };
                //使用分期
                if (data.payType == CreditCardEnum.PayType.INSTALLMENT_SALE)
                {
                    reqData.TransType = CreditCardEnum.UbotNewTransType.INSTALLMENT.ToCode();
                    reqData.HostID = CreditCardEnum.UbotNewHostID.PERIOD.ToCode();
                }
                //交易含代收則要代入代收金額含代收收續費
                if (data.HasSaleCollection)
                {
                    //總代收金額(包含代收手續費)
                    string strTotalArcAmt = (Convert.ToInt32(data.arcAmt) + Convert.ToInt32(data.FeedAmt)).ToString();
                    reqData.SubAmt = strTotalArcAmt;
                }
            }
            else //一段式電文
            {
                reqData = new UbotNewTradeModel()
                {
                    TransType = CreditCardEnum.UbotNewTransType.SALE.ToCode(),
                    HostID = HostID,
                    TransAmt = ((int)(data.amt)).ToString(),
                    ExceptionAmt = intExceptionAmt.ToString(),
                    MerchantCode = data.StoreID,
                    CardNo = "".PadLeft(18, ' '),
                    StoreID = data.StoreID
                };
            }
            //扣款
            respData = Send(reqData);
            respCode = CreditCardEnum.ParserUbotNew.RespCode(respData.RespCode);
            HostID = respData.HostID;//20240217-改從01電文取HostID

            Devices.Models.CreditCardModels.CreditCardResponse response01 = responseFromModel(respData, reqData.TransAmt);
            //DB Bincode_List比對用卡號
            response01.CardNoForBinList = strCardNoForBinList;

            if (respCode != CreditCardEnum.UbotNewRespCode.Approval
                && respCode != CreditCardEnum.UbotNewRespCode.AppvBatchFull
                && respCode != CreditCardEnum.UbotNewRespCode.AppvNeedSign
                && respCode != CreditCardEnum.UbotNewRespCode.UploadFail
                && respCode != CreditCardEnum.UbotNewRespCode.Error)
            {
                //response01 = processTimeOut(reqData);
                ////DB Bincode_List比對用卡號
                //response01.CardNoForBinList = strCardNoForBinList;
                //if (response01.status != Devices.Models.CreditCardModels.CreditCardResponse.CreditCardStatus.Succ)
                //{
                //    return response01;
                //}
                response01 = Send55Request(reqData);
                response01.CardNoForBinList = strCardNoForBinList;
            }
            //2024/05/09不需發55，商店聯用01印
            //if (respCode == CreditCardEnum.UbotNewRespCode.UploadFail)
            //{
            //    var repData55 = Send55Request(reqData);
            //    HostID = repData55.HostID;//20240217-01電文TIMEOUT，則從55電文取HostID
            //}
            // 確認扣款結束寫入活動及點加金(一段式條段不需寫入)
            if (Send60)
            {
                #region 點加金
                if ((respCode == CreditCardEnum.UbotNewRespCode.UploadFail) || (respCode == CreditCardEnum.UbotNewRespCode.Approval)
                    || (respCode == CreditCardEnum.UbotNewRespCode.AppvNeedSign))
                {
                    new PaymentService().UpdatePointAmountSession(new Models.TransModel.UpdatePointAmountSession()
                    {
                        PointAmount = objPointAmount.body.DiscAmount,
                        BarcodeData = objPointAmount.body.BarcodeData
                    });
                    // 確認扣款結束成功後再寫入活動獎號Session
                    SessionService.SetSession("PromotePrintCampaign", promotePrintCampaign);
                    //// 確認扣款結束成功後再寫入活動錯誤訊息
                    //SessionService.ClearSession("EdcActErrMsg");
                    SessionService.SetSession("EdcActErrMsg", campaignErrorMsg);
                }
                response01.Amount = objPointAmount.body.PaymentAmount;
                response01.DiscAmount = objPointAmount.body.DiscAmount;
                response01.Act_Name = objPointAmount.body.Campaign_Name;
            }
            else //一段式電文
            {
                response01.Amount = data.amt;
            }
            #endregion
            string strCardNoTit = respData.CardNo.Substring(0, 1);
            switch (data.payType)
            {
                case CreditCardEnum.PayType.INSTALLMENT_SALE:
                    switch (strCardNoTit)
                    {
                        case "3":
                            response01.CardType = CreditCardEnum.CardType.JCB;
                            break;
                        case "4":
                            response01.CardType = CreditCardEnum.CardType.VISA;
                            break;
                        case "5":
                            response01.CardType = CreditCardEnum.CardType.MASTER;
                            break;
                    }
                    break;
                case CreditCardEnum.PayType.TRANS_SALE:
                    switch (strCardNoTit)
                    {
                        case "3":
                            response01.CardType = CreditCardEnum.CardType.JCB;
                            break;
                        case "4":
                            response01.CardType = CreditCardEnum.CardType.VISA;
                            break;
                        case "5":
                            response01.CardType = CreditCardEnum.CardType.MASTER;
                            break;
                    }
                    break;
            }
            response01.HostID = HostID;

            //以銀行別判斷卡種
            switch (HostID)
            {
                //花旗銀行
                case "00":
                    response01.CardType = CreditCardEnum.CardType.DinerSclub;
                    break;
                //美國運通
                case "01":
                    response01.CardType = CreditCardEnum.CardType.AE;
                    break;
                //CUP銀聯
                case "02":
                    response01.CardType = CreditCardEnum.CardType.CUP;
                    break;
            }
            return response01;
        }

