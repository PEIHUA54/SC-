            string TransType = CreditCardEnum.UbotNewTransType.CHECKBIN.ToCode();
            var reqData = new UbotNewTradeModel();
            var promotePrintCampaign = new List<EDC_ACT>();
            var objPointAmount = new BaseModels.BaseResult<CalculatePointAmountResult>();
            //排他金額(菸品)
            int intExceptionAmt = Convert.ToInt32(data.Smoke);
            switch (data.payType)
            {
                case CreditCardEnum.PayType.INSTALLMENT_SALE:
                    HostID = CreditCardEnum.UbotNewHostID.PERIOD.ToCode();
                    BinCheckflag = "3";
                    break;
                case CreditCardEnum.PayType.TRANS_SALE:
                    HostID = CreditCardEnum.UbotNewHostID.CREDITCARD.ToCode();
                    if (data.HasSaleCollection)
                        BinCheckflag = "2";
                    else
                        BinCheckflag = "1";
                    break;
            }
            #region 判斷是否要走一段式電文   
            POSLocalEntities db = new POSLocalEntities();
            bool hasPdaica = false, hasPromote = false, Send60 = false;
            string[] pay_list = new string[] { "30D1", "30D2", "30D3", "30D4", "30D5" };
            string[] pro_list = new string[] { "9", "J", "K", "F", "8", "I" };
            string campaignSN = "";
            //1. 判斷是否有中台活動
            var ACT_LISTs = new BusinessRules.Payment().GetUBActPlatformData("30D1", data.StoreID.Substring(0, 4));
            bool hasUbact = new BusinessRules.Payment().HasUBActPlatformAct(ACT_LISTs);

            //2.是否有VIP券
            hasPromote = db.PromoteSetting.AsEnumerable()
                    .Select(x => new PromoteSetting()
                    {
                        Mode = x.Mode,
                        Date = x.Date,
                    }).Where(x => x.Date == data.POSDateTime.ToString("yyyyMMdd") && pro_list.Contains(x.Mode)).Any();
            //3.是否有點加金活動
            hasPdaica = new BusinessRules.Payment().HasPdaicaAct(pay_list);
            // 1.無中台活動 2.無VIP券活動 3.無點加金 4.無代收 5.非分期 符合以上5個條件才可走一段式電文
            if (!hasUbact && !hasPdaica && !hasPromote && !data.HasSaleCollection && data.payType != CreditCardEnum.PayType.INSTALLMENT_SALE)
                Send60 = false;
            else
                Send60 = true;
            #endregion
            if (Send60)
            {
                // 取得中台指定活動案號
                campaignSN = new BusinessRules.Payment().GetUBAssignActNo(ACT_LISTs, data.StoreID.Substring(0, 4));
                //卡片查詢
                string msg = "";
                respData = readCardCheckBin(data, TransType, HostID, BinCheckflag, hasUbact, campaignSN,out msg);

                //詢卡回傳卡號前9碼為明碼
                strCardNoForBinList = respData.CardNo;
                //如果有代收交易且詢卡後HostID="02"銀聯卡且卡號比對不成功，2022/10/21修改只查ArcBincode若db沒有卡號資料且銀行別非聯邦皆阻擋
                if (data.HasSaleCollection && respData.RespCode == "9999")
