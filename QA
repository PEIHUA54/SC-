        public void getRefundCardType(string strTrans, string strTransNo = "", string strPayType = "",string strTransType="")
        {
            if (string.IsNullOrEmpty(strTrans) && string.IsNullOrEmpty(strPayType))
            {
                RefundCardType = CreditCardEnum.CardType.UNKNOWN;
            }
            //特殊EDC交易如雲冰付款退款或特殊卡別
            else if (!string.IsNullOrEmpty(strTransType)||!string.IsNullOrEmpty(strPayType))
            {
                RefundCardType = Parser.FromSecType(strPayType);
                strTransToRefund = strTrans;
                strTransNoToRefund = strTransNo;
            }
            else
            {
                string TransNo = "";
                string SalesDate = "";
                //行動支付退貨，手動輸入
                if (strTrans.Length == 8)
                {
                    SalesDate = strTrans;
                    if (strTransNo.Length == 15)
                        TransNo = strTransNo.Substring(9,6);
                    else
                        TransNo = strTransNo;
                }
                //作廢發票只輸入交易序號
                else if (strTrans.Length == 6)
                {
                    SalesDate = new PosConfig().GetSaleDate().Replace("-", "");
                    TransNo = strTrans;
                }
                //行動支付退貨，掃秒barcode
                else
                {
                    SalesDate = strTrans.Substring(0, 8);
                    TransNo = strTrans.Substring(9, 6);
                }
                strTransToRefund = SalesDate;
                strTransNoToRefund = TransNo;
                POSLocalEntities db = new POSLocalEntities();
                var TransPayments = db.Trans_P.Where(x => x.Trans_No == TransNo && x.Sales_Date == SalesDate).FirstOrDefault();
                //如果strPayType不為空或NULL則指定TransPayments.Sec_Type=strPayType
                if (!string.IsNullOrEmpty(strPayType))
                {
                    TransPayments.Sec_Type = strPayType;
                }
                RefundCardType = Parser.FromSecType(TransPayments?.Sec_Type);
            }

        }

