## 4. `EDCService.cs` — SettlementAll() 完整版

```csharp
public CreditSettleResponse SettlementAll()
{
    CreditSettleResponse result = new CreditSettleResponse();
    CreditCardEnum.ActionStatus res;
    result.Credit = true;
    result.Ins = true;
    result.CUP = true;
    result.AE = true;

    #region Settlement
    if (edcType == EDCType.CTBC)
    {
        generateStoreID();
        res = Settlement(CreditCardEnum.CtbcHostID.CREDITCARD.ToCode());
        if (res != CreditCardEnum.ActionStatus.SUCC) result.Credit = false;

        generateStoreID();
        res = Settlement(CreditCardEnum.CtbcHostID.PERIOD.ToCode());
        if (res != CreditCardEnum.ActionStatus.SUCC) result.Ins = false;

        generateStoreID();
        res = Settlement(CreditCardEnum.CtbcHostID.CUP.ToCode());
        if (res != CreditCardEnum.ActionStatus.SUCC) result.CUP = false;

        generateStoreID();
        res = Settlement(CreditCardEnum.CtbcHostID.AE.ToCode());
        if (res != CreditCardEnum.ActionStatus.SUCC) result.AE = false;
    }
    else if (edcType == EDCType.UBOT)
    {
        generateStoreID();
        res = Settlement(CreditCardEnum.UbotHostID.CREDITCARD.ToCode());
        if (res != CreditCardEnum.ActionStatus.SUCC) result.Credit = false;

        generateStoreID();
        res = Settlement(CreditCardEnum.UbotHostID.CUP.ToCode());
        if (res != CreditCardEnum.ActionStatus.SUCC) result.CUP = false;
    }
    else if (edcType == EDCType.NEWUBOT)
    {
        // 判斷 DeviceVersion 目錄下有沒有 EDCVersion_ 開頭的檔案，決定清帳順序
        bool hasEdcVersion = !string.IsNullOrEmpty(new POS.Devices.DeviceSharedFunctions().GetDeviceVersion("EDCVersion"));

        if (hasEdcVersion)
        {
            // 有版號：銀聯交易→AE交易→一般交易
            generateStoreID();
            res = Settlement(CreditCardEnum.UbotNewHostID.CUP.ToCode());
            if (res != CreditCardEnum.ActionStatus.SUCC) result.CUP = false;

            generateStoreID();
            res = Settlement(CreditCardEnum.UbotNewHostID.AE.ToCode());
            if (res != CreditCardEnum.ActionStatus.SUCC) result.AE = false;

            generateStoreID();
            res = Settlement(CreditCardEnum.UbotNewHostID.CREDITCARD.ToCode());
            if (res != CreditCardEnum.ActionStatus.SUCC) result.Credit = false;
        }
        else
        {
            // 無版號：一般交易→銀聯交易→AE交易
            generateStoreID();
            res = Settlement(CreditCardEnum.UbotNewHostID.CREDITCARD.ToCode());
            if (res != CreditCardEnum.ActionStatus.SUCC) result.Credit = false;

            generateStoreID();
            res = Settlement(CreditCardEnum.UbotNewHostID.CUP.ToCode());
            if (res != CreditCardEnum.ActionStatus.SUCC) result.CUP = false;

            generateStoreID();
            res = Settlement(CreditCardEnum.UbotNewHostID.AE.ToCode());
            if (res != CreditCardEnum.ActionStatus.SUCC) result.AE = false;
        }
    }
    #endregion

    return result;
}
