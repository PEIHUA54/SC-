        private CreditCardResponse localPrevTransIsEDC()
        {
            POSLocalEntities db = new POSLocalEntities();

            var lastTransNo = db.Trans_P.OrderByDescending(x => x.id).Select(x => x.Trans_No).FirstOrDefault();
            var lastTransPayments = db.Trans_P.Where(x => x.Trans_No == lastTransNo).ToList();

            var res = lastTransPayments.Where(x => PaymentIdAll.Contains(x.Pay_Id)).FirstOrDefault();
            if (res is null) return null;
            RefundCardType = Parser.FromSecType(res.Sec_Type);
            DateTime POSDateTime;
            if (edcType == EDCType.UBOT || edcType == EDCType.NEWUBOT)
            {
                string salesDate = res.Pay_Order_No.Substring(13, 1);
                salesDate = Convert.ToInt32(salesDate, 16).ToString().PadLeft(2, '0');
                salesDate = res.Pay_Order_No.Substring(11, 2) + salesDate + res.Pay_Order_No.Substring(14);
                //店號(四碼) + 機號(一碼) + 交易序號(六碼) + 西元年末兩碼 + 月份(0~9不變10 > A 11 > B 12 > C)一碼 + 日(兩碼) + 時(兩碼) + 分(兩碼)
                POSDateTime = DateTime.ParseExact(salesDate, "yyMMddHHmm", System.Globalization.CultureInfo.CurrentCulture);

            }
            else
            {
                POSDateTime = DateTime.ParseExact(res.Pay_Order_No.Substring(0, 14), "yyyyMMddHHmmss", System.Globalization.CultureInfo.CurrentCulture);
            }
            return new CreditCardResponse()
            {
                CardType = Parser.FromSecType(res.Sec_Type),
                TerminalID = res.Terminal,
                CardNo = res.Sec_No,
                TransDateTime = DateTime.ParseExact(res.Credit_Date + res.Credit_Time, "yyMMddHHmmss", System.Globalization.CultureInfo.CurrentCulture),
                ApprovalCode = res.Authorization,
                StoreID = res.Pay_Order_No,
                Amount = res.Amount ?? 0,
                POSDateTime = POSDateTime// DateTime.ParseExact(res.Pay_Order_No.Substring(0, 14), "yyyyMMddHHmmss", System.Globalization.CultureInfo.CurrentCulture),
            };
        }

