/// <summary>
/// 版本資訊
/// </summary>
/// <returns></returns>
public ActionResult LeftVersionInfo()
{
    List<string> versions = new List<string>();
    //取得arc版本號
    var getARCVersion = db.CollectingBanks.Where(x => x.DATA_TYPE == "VR").FirstOrDefault();
    if (getARCVersion != null)
        versions.Add(getARCVersion.DATA);
    //悠遊卡韌體版本
    versions.Add("悠遊卡機韌體版本=" + new POS.Devices.DeviceSharedFunctions().GetDeviceVersion("DongleReaderVersion"));
    //熱感機韌體版本
    versions.Add("發票機韌體版本=" + new POS.Devices.DeviceSharedFunctions().GetDeviceVersion("PrinterVersion"));
    //刷卡機版號
    string edcVersion = new POS.Devices.DeviceSharedFunctions().GetDeviceVersion("EDCVersion");
    if (!string.IsNullOrEmpty(edcVersion))
        versions.Add("刷卡機版號=" + edcVersion);

    ViewBag.LeftVersionInfo = versions;
    return PartialView();
}
